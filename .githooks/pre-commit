#!/bin/sh
set -e

# Ensure the script runs from the repository root
cd "$(git rev-parse --show-toplevel)"

echo "Checking for typos..."
typos

echo "Formatting Rust code..."
# The repo is a cargo workspace; `cargo fmt` at the root covers every member.
cargo fmt --all

# Get staged Rust files and re-stage them so the formatting is included in the commit
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$RUST_FILES" ]; then
  echo "$RUST_FILES" | tr '\n' '\0' | xargs -0 -r git add
fi

echo "Running Clippy (all workspace members)..."
cargo clippy --workspace --all-targets --all-features -- -D warnings

echo "Fixing all markdown files..."
# 1. Find every .md file, explicitly IGNORING the target/ and .git/ folders.
#    Paths git ignores (a local docs/ directory, say) are skipped as well:
#    rumdl has no business rewriting them, and step 2 would fail on them.
find . -type d \( -name target -o -name .git \) -prune -o -type f -name "*.md" ! -name "CHANGELOG.md" -exec sh -c '
  for f do
    if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 && git check-ignore -q -- "$f"; then
      continue
    fi
    rumdl check --fix "$f"
  done
' sh {} +

# 2. Stage the fixed files so they make it into the commit. `git add` refuses
#    ignored paths and `set -e` would abort the commit, so the same filter.
find . -type d \( -name target -o -name .git \) -prune -o -type f -name "*.md" ! -name "CHANGELOG.md" -exec sh -c '
  for f do
    if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 && git check-ignore -q -- "$f"; then
      continue
    fi
    git add -- "$f"
  done
' sh {} +

exit 0
